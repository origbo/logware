# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/logware

# JWT Secret
JWT_SECRET=your-secret-key-replace-in-production

# Logging Configuration
LOG_LEVEL=info

# Email Configuration (for password resets and notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=Logware <noreply@logware.example.com>

# Integration API Keys (examples for common security tools)
OSSIM_API_KEY=your-ossim-api-key
WIRESHARK_API_KEY=your-wireshark-api-key
SPLUNK_API_KEY=your-splunk-api-key
ELK_API_KEY=your-elk-api-key

# Feature Flags
ENABLE_REAL_TIME_ALERTS=true
ENABLE_AUTOMATED_REPORTS=true
ENABLE_VULNERABILITY_SCANNING=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/path/to/backup

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
