# Docker Deployment Environment Variables
# Database Configuration
MONGO_USERNAME=logware
MONGO_PASSWORD=secure_password_change_in_production
MONGODB_URI=mongodb://logware:secure_password_change_in_production@mongodb:27017/logware?authSource=admin

# API Configuration
BACKEND_PORT=5000
API_URL=http://localhost:5000/api

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_URL=http://localhost

# Security
JWT_SECRET=secure_jwt_secret_change_in_production

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Logware <notifications@example.com>

# Integration API Keys
OSSIM_API_KEY=your_ossim_api_key
WIRESHARK_API_KEY=your_wireshark_api_key
SPLUNK_API_KEY=your_splunk_api_key
ELK_API_KEY=your_elk_api_key
